# LLM backend (required — powers all 4 agents)
GROQ_API_KEY=

# Claude (declared, optional for future model swap)
ANTHROPIC_API_KEY=

# GitHub — required for live mode (GITHUB_MODE=live)
GITHUB_TOKEN=
# GitHub org prefix for repo names. Set to "apache" to use real apache/* repos in live mode.
GITHUB_ORG=company

# Jira — only needed for private/internal Jira instances
# Apache public Jira (default) works without auth
JIRA_URL=https://issues.apache.org/jira
JIRA_TOKEN=
JIRA_EMAIL=

# Elasticsearch — for live log backend (docker compose up -d)
ES_URL=http://localhost:9200
ES_INDEX=ens-logs

# MCP server modes: mock (default) or live
LOGS_MODE=mock
GITHUB_MODE=mock
JIRA_MODE=mock

# Slack slash command webhook signature verification
# Get from: api.slack.com/apps > Your App > Basic Information > Signing Secret
SLACK_SIGNING_SECRET=
