# LLM backend — agents try OpenAI (gpt-4o, gpt-4o-mini) first, then Groq.
# At least one key required. OpenAI gives best quality; Groq is the free fallback.
OPENAI_API_KEY=
GROQ_API_KEY=

# Claude (declared, optional for future model swap)
ANTHROPIC_API_KEY=

# GitHub — required for live mode (GITHUB_MODE=live)
GITHUB_TOKEN=
# GitHub org prefix for repo names. Set to "apache" to use real apache/* repos in live mode.
GITHUB_ORG=company

# Jira — only needed for private/internal Jira instances
# Apache public Jira (default) works without auth
JIRA_URL=https://issues.apache.org/jira
JIRA_TOKEN=
JIRA_EMAIL=

# Elasticsearch — for live log backend (docker compose up -d)
ES_URL=http://localhost:9200
ES_INDEX=ens-logs

# Job store — set REDIS_URL for durable, multi-replica job state.
# Unset = in-memory store (single replica, lost on restart).
REDIS_URL=
JOB_TTL_SECONDS=3600

# MCP server modes: mock (default) or live
LOGS_MODE=mock
GITHUB_MODE=mock
JIRA_MODE=mock

# Slack slash command webhook signature verification
# Get from: api.slack.com/apps > Your App > Basic Information > Signing Secret
SLACK_SIGNING_SECRET=

# API key for POST /analyze — if set, X-API-Key header is required on all requests
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=
